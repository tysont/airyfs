{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "declaration": true, "declarationMap": true, "sourceMap": true,
    "outDir": "./dist", "rootDir": "./src", "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*"]
}
